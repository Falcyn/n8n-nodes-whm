{
  "name": "n8n-nodes-whm",
  "version": "1.0.0",
  "description": "n8n community node for cPanel & WHM (WebHost Manager). Manage accounts, packages, DNS zones, SSL, resellers, services, backups and cPanel-level email, databases, domains and FTP through the WHM API, plus a trigger for WHM hook events.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "whm",
    "cpanel",
    "webhost-manager",
    "hosting",
    "automation"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Falcyn/n8n-nodes-whm#readme",
  "author": {
    "name": "Anthony Tuberville",
    "email": "4618821+Falcyn@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Falcyn/n8n-nodes-whm.git"
  },
  "bugs": {
    "url": "https://github.com/Falcyn/n8n-nodes-whm/issues"
  },
  "engines": {
    "node": ">=18.10"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && npm run lint -c .eslintrc.prepublish.js nodes credentials package.json"
  },
  "files": [
    "dist",
    "bridge"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/WhmApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Whm/Whm.node.js",
      "dist/nodes/Whm/WhmTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "n8n-workflow": "2.16.0",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "js-yaml": "^4.3.2",
    "form-data": "^4.0.6",
    "uuid": "^11.1.1",
    "minimatch@3": {
      "brace-expansion": "^1.1.21"
    },
    "minimatch@9": {
      "brace-expansion": "^2.1.7"
    },
    "minimatch@10": {
      "brace-expansion": "^5.0.12"
    }
  }
}
